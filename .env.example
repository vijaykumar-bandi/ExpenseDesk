# ExpenseDesk root environment.
# Copy to .env and adjust. The backend reads backend/.env (created by `npm run dev`).

# Ports used by `npm run dev`
PORT=5173
API_PORT=8000

# The live app's first Administrator, created after the migrations when both are set
# and no account exists. Never used by the development seeder.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=
