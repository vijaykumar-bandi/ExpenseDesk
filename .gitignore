# Nexgile Greenfield: the project's local state, and your own documents
.nexgile/greenfield/state.json
.nexgile/greenfield/thread.jsonl
.nexgile/greenfield/checkpoints/
docs/input/

# Dependencies
node_modules/
vendor/

# Build output
frontend/dist/
frontend/coverage/
backend/public/build/
backend/public/hot

# Environment and secrets
.env
.env.*
!.env.example
backend/.env
